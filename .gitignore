# --- dependencies ---------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# --- build output ---------------------------------------------------------
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# The bridge is generated by `npm run build:userscript` on every build,
# including on Vercel. Committing it would guarantee a stale copy that trusts
# the wrong origin.
public/silentfeed.user.js
public/silentfeed.user.js.map

# --- tooling caches -------------------------------------------------------
.vite/
.cache/
.eslintcache
.npm
.node_repl_history
*.tgz

# --- platform -------------------------------------------------------------
.vercel/

# --- environment ----------------------------------------------------------
# No secrets are needed to run this project. These are here so that a stray
# env file can never be committed by accident.
.env
.env.*
!.env.example

# --- logs -----------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- editors --------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# --- operating systems ----------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
